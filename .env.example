# --- Brain ---
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000

# --- LLM (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_MAX_HISTORY=20          # recent turns kept per session

# --- STT (faster-whisper) ---
WHISPER_MODEL=base.en       # faster voice loop; use small.en for better accuracy
WHISPER_DEVICE=cpu          # reliable local default on Apple Silicon
WHISPER_COMPUTE_TYPE=int8

# --- TTS ---
TTS_ENGINE=kokoro               # primary local TTS; falls back to 'say' if Kokoro is unavailable
SAY_VOICE=Moira                 # macOS voice name. Other options:
                                # Karen (Australian), Samantha (American), Tessa (South African)
SAY_RATE=185                    # words per minute; 185 is the natural default
KOKORO_MODEL=mlx-community/Kokoro-82M-bf16
KOKORO_VOICE=af_heart           # try af_heart first; Kokoro has many local voice presets
KOKORO_SPEED=1.0
KOKORO_LANG_CODE=a              # a = American English, b = British English
KOKORO_SAMPLE_RATE=24000

WAKE_ENGINE=whisper
WAKE_PHRASE=hey synthesis
# WAKE_MODEL accepts either:
#   * a pretrained openWakeWord name: alexa, hey_mycroft, hey_jarvis, hey_rhasspy
#   * a path to a custom-trained .onnx file (relative to project root, or absolute)
# To train your own "Hey Synthesis" model, see docs/wake_word_training.md and
# install the result with: scripts/install_custom_wake_word.py path/to/file.onnx
WAKE_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5           # 0.0–1.0; raise to reduce false triggers
WAKE_CHIME_ENABLED=false     # false = fastest wake-to-listen handoff
WAKE_PRE_ROLL_MS=160         # audio kept before wake fires; lower = less wake-word audio in STT
WAKE_PHRASE=hey synthesis    # used only when WAKE_ENGINE=whisper
WAKE_WHISPER_MODEL=tiny.en
WAKE_WHISPER_WINDOW_MS=1200
WAKE_WHISPER_POLL_MS=350

# --- VAD ---
VAD_SILENCE_MS=600           # how long of silence ends an utterance
NO_SPEECH_TIMEOUT_S=4.0      # timeout after wake if no speech starts

# --- Visualizer ---
VISUALIZER_BUS_ENABLED=true
VISUALIZER_BUS_HOST=127.0.0.1
VISUALIZER_BUS_PORT=8765
VISUALIZER_AUTO_START=true     # launch pygame automatically with app.daemon

# --- Memory (v0.5) ---
# Long-term semantic recall of past conversations. Each completed turn-pair
# is embedded via Ollama and stored in SQLite + sqlite-vec. On every new
# turn, the top-K most relevant past turn-pairs (above the threshold) are
# silently injected into the LLM prompt under a <memory> block.
#
# First-time setup:
#   ollama pull nomic-embed-text
#   .venv/bin/python scripts/smoke_memory.py     # sanity-check recall
#   then flip MEMORY_ENABLED=true
#
# Inspect / forget:
#   .venv/bin/python -m scripts.memory stats
#   .venv/bin/python -m scripts.memory list --limit 20
#   .venv/bin/python -m scripts.memory search "query" --top-k 5
#   .venv/bin/python -m scripts.memory forget <id>
#   .venv/bin/python -m scripts.memory wipe --yes
MEMORY_ENABLED=false
MEMORY_DB_PATH=data/synthesis_memory.db
MEMORY_EMBED_MODEL=nomic-embed-text
MEMORY_EMBED_DIM=768
MEMORY_RECALL_TOP_K=3
MEMORY_RECALL_THRESHOLD=0.65   # cosine similarity floor; raise for stricter recall

# --- Audio ---
SAMPLE_RATE=16000
# Leave blank to use the system default.
INPUT_DEVICE=
OUTPUT_DEVICE=
