# --- Brain ---
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000

# --- LLM (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_MAX_HISTORY=20          # turns kept per session before older ones drop

# --- STT (faster-whisper) ---
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu          # 'cpu' is fastest on Apple Silicon for small.en
WHISPER_COMPUTE_TYPE=int8

# --- TTS (macOS `say` for v0; Piper/MLX in v0.5) ---
TTS_ENGINE=say                  # 'say' = macOS native; 'piper' planned for v0.5
SAY_VOICE=Moira                 # Irish female, FRIDAY-adjacent. Other options:
                                # Karen (Australian), Samantha (American), Tessa (South African)
SAY_RATE=185                    # words per minute; 185 is the natural default

# --- Wake word ---
WAKE_MODEL=hey_jarvis        # openWakeWord pretrained slug
WAKE_THRESHOLD=0.5           # 0.0–1.0; raise if false-triggering

# --- VAD ---
VAD_SILENCE_MS=900           # how long of silence ends an utterance

# --- Audio ---
SAMPLE_RATE=16000
INPUT_DEVICE=                # blank = system default
OUTPUT_DEVICE=               # blank = system default
